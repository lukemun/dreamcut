    "next": "16.3.8",
    "playwright-core": "1.61.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "0.185.1",
    "tw-animate-css": "1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
