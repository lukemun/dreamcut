    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/blob": "2.8.0",
    "@webgpu/types": "^0.1.74",
    "cross-env": "^10.1.0",
    "electron": "44.7.0",
