{
  "name": "dreamcut",
  "private": true,
  "version": "0.1.2",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22 || >=24"
  },
  "description": "The editor for dreamers. A local, agent-native video editor with an editable timeline, human review, and shared browser preview and rendering.",
  "scripts": {
    "eval:citadella": "tsx scripts/eval-citadella.ts",
    "eval:citadella:check": "node --test scripts/codex-tool-trial.test.mjs scripts/citadella-trial-policy.test.mjs",
    "eval:reveals": "tsx scripts/eval-reveals.ts",
    "eval:editing": "tsx scripts/eval-editing.ts",
    "eval:editing:check": "tsx --test src/lib/agent/editing-eval.test.ts",
    "eval:dial-selection": "tsx scripts/eval-dial-selection.ts",
    "eval:dial-selection:check": "tsx --test src/lib/agent/dial-selection-eval.test.ts",
    "eval:local-models": "tsx scripts/eval-local-models.mts",
    "bootstrap": "tsx scripts/setup-local.ts",
    "setup:rust": "tsx scripts/setup-local.ts --rust",
    "test:setup:rust": "tsx --test src/lib/native-preview/setup.test.ts",
    "dev:rust": "cross-env DREAMCUT_NATIVE_PREVIEW=1 NEXT_PUBLIC_DREAMCUT_NATIVE_PREVIEW=1 TIMELINE_NEXT_DIST_DIR=.next-native TIMELINE_EDITOR_MODE=development tsx scripts/server-with-otel.ts dev --turbopack -H 127.0.0.1 -p 3143",
    "setup:check": "tsx scripts/setup-local.ts --check",
    "setup:voice": "tsx scripts/setup-local.ts --voice",
    "dev": "cross-env TIMELINE_EDITOR_MODE=development tsx scripts/server-with-otel.ts dev --turbopack -H 127.0.0.1 -p 3123",
    "build": "next build",
    "start": "tsx scripts/server-with-otel.ts start -H 127.0.0.1 -p 3123",
    "review:build": "cross-env TIMELINE_EDITOR_MODE=review TIMELINE_REVIEW_BUILD=1 TIMELINE_NEXT_DIST_DIR=.next-review next build",
    "review:start": "cross-env TIMELINE_EDITOR_MODE=review TIMELINE_NEXT_DIST_DIR=.next-review tsx scripts/server-with-otel.ts start -H 127.0.0.1 -p 3124",
    "review": "tsx scripts/review-launch.ts",
    "review:open": "tsx scripts/review-launch.ts --open",
    "walkthrough-workflow": "tsx scripts/product-walkthrough-workflow.ts",
    "walkthrough-capture-atlas": "tsx scripts/walkthrough-capture-atlas.ts",
    "walkthrough-source-readiness": "tsx scripts/walkthrough-source-readiness.ts",
    "walkthrough-rough-spine-readiness": "tsx scripts/walkthrough-rough-spine-readiness.ts",
    "walkthrough-assembly-readiness": "tsx scripts/walkthrough-assembly-readiness.ts",
    "walkthrough-boundary-integrity": "tsx scripts/walkthrough-boundary-integrity.ts",
    "walkthrough-review-readiness": "tsx scripts/walkthrough-review-readiness.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test:core": "node scripts/test-core.mjs",
    "check:core": "pnpm typecheck && pnpm test:core",
    "test": "node --import tsx --test-concurrency=4 --test mcp/*.test.mjs src/components/studio/timeline/*.test.ts src/components/ui/*.test.ts src/lib/timeline/*.test.ts src/lib/qc/*.test.ts src/lib/instruments/*.test.ts src/lib/agent/*.test.ts src/lib/local-store/*.test.ts src/lib/layout-proposals/*.test.ts src/lib/library/*.test.ts src/lib/media-analysis/*.test.ts src/lib/remotion/*.test.ts src/lib/frame-runtime/*.test.ts src/lib/render/*.test.ts src/lib/tutorial-motion/*.test.ts src/lib/export/*.test.ts scripts/pr-quality.test.mjs scripts/cloud-learning.test.ts scripts/private-file-scan-input.test.mjs scripts/check-catalog-privacy.test.mjs scripts/code-review-hook.test.mjs src/lib/native-preview/*.test.ts src/lib/hyperframes/*.test.ts src/lib/sound-synth/*.test.ts src/lib/storyboard/*.test.ts src/components/studio/storyboard/*.test.ts",
    "preprocess": "tsx scripts/preprocess.ts",
    "color-managed-video": "tsx scripts/color-managed-video.ts",
    "render": "tsx scripts/render.ts",
    "seed-demo": "tsx scripts/seed-demo.ts",
    "import-media": "tsx scripts/import-media.ts",
    "take-auditions": "tsx scripts/seed-take-auditions.ts",
    "build-take-audition": "tsx scripts/build-take-audition.ts",
    "seed-ui-smoke": "tsx scripts/seed-ui-smoke.ts",
    "qc": "tsx scripts/qc.ts",
    "preview-readiness": "tsx scripts/preview-readiness.ts",
    "animation-preview-proxy": "tsx scripts/animation-preview-proxy.ts",
    "hyperframes-overlay": "tsx scripts/hyperframes-overlay.ts",
    "sound-synth": "tsx scripts/sound-synth.ts",
    "transcribe": "tsx scripts/transcribe.ts",
    "align": "tsx scripts/align.ts",
    "captions-from-alignment": "tsx scripts/captions-from-alignment.ts",
    "caption-geometry": "tsx scripts/caption-geometry.ts",
    "frame-state": "tsx scripts/frame-state.ts",
    "presenter-layout-check": "tsx scripts/presenter-layout-check.ts",
    "animation-layout-check": "tsx scripts/animation-layout-check.ts",
    "interaction-targets": "tsx scripts/audit-interaction-targets.ts",
    "frames": "tsx scripts/frames.ts",
    "probe": "tsx scripts/probe.ts",
    "rough-cut": "tsx scripts/rough-cut.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:effect-primitives": "tsx scripts/verify-effect-primitives-render.ts",
    "verify:source-frames": "tsx scripts/verify-source-frame-parity.ts",
    "verify:export-resolution": "tsx scripts/verify-export-resolution.ts",
    "verify:render-goldens": "tsx scripts/verify-render-goldens.ts",
    "benchmark:gpu-seeks": "tsx scripts/benchmark-gpu-seeks.ts",
    "verify:color-grade": "tsx scripts/verify-color-grade-render.ts",
    "verify:chroma-key": "tsx scripts/verify-chroma-key-render.ts",
    "verify:colin-effect": "tsx scripts/verify-colin-effect-render.ts",
    "beat-grid": "tsx scripts/beat-grid.ts",
    "reframe": "tsx scripts/reframe.ts",
    "export-fcpxml": "tsx scripts/export-fcpxml.ts",
    "scenes": "tsx scripts/scenes.ts",
    "music-analyze": "tsx scripts/music-analyze.ts",
    "music-promote": "tsx scripts/music-promote.ts",
    "music-import-bundle": "tsx scripts/music-import-bundle.ts",
    "music-catalog-storage": "tsx scripts/music-catalog-storage.ts",
    "music-tempo-audition": "tsx scripts/music-tempo-audition.ts",
    "sfx-analyze": "./.venv-music/bin/python scripts/sfx-analyze.py",
    "image-analyze": "tsx scripts/image-analyze.ts",
    "personal-library-move": "tsx scripts/personal-library-move.ts",
    "alpha-footprints": "tsx scripts/alpha-footprints.ts",
    "scratchpad-cutout": "tsx scripts/scratchpad-cutout.ts",
    "eval:hand-swipe-models": "tsx scripts/eval-hand-swipe-models.ts",
    "caption-wrap-parity": "tsx scripts/caption-wrap-parity.ts",
    "task-metrics": "tsx scripts/task-metrics.ts",
    "tool-candidates": "tsx scripts/activity-retro.ts",
    "activity-retro": "tsx scripts/activity-retro.ts",
    "control-gaps": "tsx scripts/control-gap-report.ts",
    "product-signals": "tsx scripts/product-signals.ts",
    "episode": "tsx scripts/episode.ts",
    "agent-activity": "tsx scripts/agent-activity.ts",
    "model-usage": "tsx scripts/model-usage.ts",
    "otel:local": "tsx scripts/otel-local.ts",
    "verify:local-otel": "tsx scripts/verify-local-otel.ts",
    "codex:local": "tsx scripts/codex-local.ts",
    "project-health": "tsx scripts/project-health.ts",
    "compact-timeline": "tsx scripts/compact-timeline.ts",
    "benchmark-editor": "tsx scripts/benchmark-editor.ts",
    "verify:playable": "tsx scripts/verify-playable-windows.ts",
    "verify:audio-playback": "tsx scripts/verify-continuous-audio-playback.ts",
    "verify:audio-live-gain": "tsx scripts/verify-audio-live-gain.ts",
    "verify:audio-volume-replay": "tsx scripts/verify-audio-volume-replay.ts",
    "verify-preview-first-load": "tsx scripts/verify-preview-first-load.ts",
    "check:pr": "pnpm check:tools && pnpm check:catalog-privacy && pnpm typecheck && pnpm check:effects && pnpm test",
    "check:catalog-privacy": "node --import tsx scripts/check-catalog-privacy.mjs",
    "review:code": "node scripts/code-review-hook.mjs pre-commit",
    "check:effects": "tsx scripts/validate-effect-recipes.ts && tsx --test src/lib/effects/recipe-visuals.test.ts",
    "verify:prepared-playback": "tsx --test src/lib/local-store/prepared-preview-jobs.test.ts src/lib/render/prepared-sections.test.ts && tsx scripts/verify-prepared-playback.ts && tsx scripts/verify-prepared-worker.ts",
    "verify:renderer": "tsx scripts/verify-renderer-contract.ts && pnpm verify:surface-tracking",
    "verify:render-contract": "pnpm verify:renderer && pnpm verify:playback && pnpm verify:prepared-playback && pnpm verify:effect-primitives && pnpm verify:still-session && pnpm verify:source-frames && pnpm verify:render-goldens",
    "verify:still-session": "tsx scripts/verify-still-session.ts",
    "verify:playback": "tsx scripts/verify-playback-contract.ts && tsx scripts/verify-playback-contract.ts --mixed",
    "check:parameter-contract": "tsx --test src/lib/agent/proposal-parameter-contract.test.ts",
    "check:editor-ui": "pnpm check:parameter-contract && tsx --test src/components/studio/timeline/inspector-control-policy.test.ts src/components/studio/timeline/inspector-sections.test.ts src/components/studio/timeline/keyframe-properties-navigation.test.ts src/components/studio/timeline/panel-shortcuts-ui.test.ts src/components/ui/visual-token-policy.test.ts src/components/studio/timeline/gpu-parity-inventory.test.ts",
    "learning:evidence": "tsx scripts/learning-evidence.ts",
    "cloud:learning": "tsx scripts/cloud-learning.ts",
    "check:agent-parity": "node scripts/check-agent-parity.mjs",
    "check:tools": "node --import tsx mcp/generate-proposal-schema.ts && node scripts/check-tool-schema-portability.mjs && node scripts/check-tool-registry.mjs && node scripts/check-agent-parity.mjs && node --import tsx scripts/check-tool-features.mjs && node --test mcp/feature-contract.test.mjs mcp/argument-errors.test.mjs && node --import tsx --test src/lib/observability/product-signals.test.ts src/lib/observability/activity-journal.test.ts src/lib/observability/episode-report.test.ts",
    "tool-usage": "tsx scripts/tool-usage.ts",
    "eval:tool-refresh": "node mcp/client-refresh-probe.mjs",
    "eval:tool-refresh:check": "node --test mcp/client-refresh-probe.test.mjs",
    "eval:tool-refresh:run": "node mcp/run-client-refresh.mjs",
    "eval:features": "node --import tsx mcp/feature-eval.mjs",
    "eval:features:check": "node --import tsx --test mcp/feature-eval.test.mjs",
    "eval:discovery": "node mcp/progressive-eval-client.mjs",
    "eval:discovery:grade": "node mcp/grade-progressive.mjs",
    "eval:discovery:check": "node --test mcp/progressive-eval-client.test.mjs mcp/grade-progressive.test.mjs",
    "eval:discovery:ollama": "node mcp/ollama-discovery-eval.mjs",
    "agent:qualify": "node mcp/local-model-suite.mjs",
    "agent:check": "node --test mcp/harness-adapters.test.mjs mcp/harness-mcp.test.mjs mcp/harness-session.test.mjs mcp/editing-harness.test.mjs mcp/harness-observability.test.mjs mcp/harness-llama.test.mjs mcp/run-editing-agent.test.mjs mcp/local-model-suite.test.mjs mcp/harness-context.test.mjs",
    "agent:health": "node --test desktop/agent-health/*.test.mjs",
    "agent:smoke": "node --no-warnings desktop/agent-health/provider-smoke.mjs",
    "eval:case": "node --no-warnings desktop/agent-health/run-editing-case.mjs",
    "agent:check:langgraph": "node --test mcp/harness-langgraph.test.mjs mcp/harness-langgraph-coordinator.test.mjs",
    "agent:run": "node mcp/run-editing-agent.mjs",
    "verify:surface-tracking": "tsx scripts/verify-surface-tracking.ts",
    "verify:prepared-blocks": "tsx --test src/lib/timeline/prepared-playback-plan.test.ts src/components/studio/timeline/prepared-preview-pool.test.ts && tsx scripts/verify-prepared-blocks.ts",
    "verify:gpu-preview": "tsx scripts/verify-gpu-preview.ts",
    "desktop:dev": "electron desktop/main.mjs",
    "desktop:check": "node --test desktop/*.test.mjs",
    "desktop:check-window-close": "electron desktop/verify-window-close.mjs",
    "desktop:voice": "node desktop/prepare-voice.mjs",
    "desktop:build": "node desktop/build.mjs",
    "desktop:package": "node desktop/package.mjs",
    "desktop:installer": "node desktop/make-installer.mjs",
    "desktop:verify-installed": "node desktop/verify-installed.mjs"
  },
