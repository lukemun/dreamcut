# Local server and storage overrides.
TIMELINE_EDITOR_BASE_URL=http://127.0.0.1:3123
TIMELINE_EDITOR_MODE=development
TIMELINE_NEXT_DIST_DIR=.next
TIMELINE_PROJECTS_DIR=projects
TIMELINE_IMAGE_CATALOG_DIR=library/images
TIMELINE_MUSIC_CATALOG_DIR=library/music
TIMELINE_SFX_CATALOG_DIR=library/sfx
TIMELINE_VISUAL_CATALOG_DIR=catalogs/visual
TIMELINE_MATTING_DIR=.matting
TIMELINE_REVIEW_BUILD=0
APP_URL=http://127.0.0.1:3123
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3123
MEDIA_BASE=http://127.0.0.1:3123

# Optional local tools and analysis controls.
AUDIO_ENHANCE_EXECUTABLE=
BEAT_PYTHON=
GITLEAKS_EXECUTABLE=gitleaks
MUSIC_PYTHON=
MFA_BIN=mfa
MFA_BEAM=
MFA_ROOT_DIR=
MFA_DICTIONARY_PATH=
WHISPER_MODEL=
WHISPER_VAD_MODEL=
MEDIA_ANALYSIS_CACHE_MAX_BYTES=
MEDIA_ANALYSIS_DETECTOR_ENABLED=false
MEDIA_ANALYSIS_FFMPEG_CONCURRENCY=2
MEDIA_PREPARATION_AUTOSTART=1
DREAMCUT_IMPORT_AUTOSTART=1
DREAMCUT_LIVE_IMPORT_TEST=0
DREAMCUT_MEDIA_PROCESS_SKILL=
APPLE_VISION_FIXTURE_MANIFEST=
APPLE_VISION_PROMOTION_REPORT=
CHROMA_DEBUG_DIR=
KEEP_COLIN_PROOF_ARTIFACTS=0

# Optional agent, profile, and diagnostics locations.
# DreamCut variables use the DREAMCUT_ prefix. Older OPENEDIT_* names are still read
# as a fallback, so an existing .env keeps working; DREAMCUT_* wins when both are set.
DREAMCUT_CODEX_EXECUTABLE=codex
DREAMCUT_WORKER_EXECUTABLE=
DREAMCUT_PROFILE_DIR=
DREAMCUT_SKILLS_DIR=.agents/skills
EDITOR_TASK_METRICS_DIR=.metrics
CODEX_HOME=

# Telemetry is off unless explicitly enabled and a destination is supplied.
SENTRY_ENABLED=0
NEXT_PUBLIC_SENTRY_ENABLED=0
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_RELEASE=
# Optional private token for build-time source-map uploads. Never use NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=

# These are read from the operating system or framework and normally should not
# be set in a project .env file: HOME, LOCALAPPDATA, XDG_CACHE_HOME,
# XDG_DATA_HOME, PATH, NODE_ENV, and NEXT_RUNTIME.

# Start a local metadata-only collector alongside dev/start/review:start.
DREAMCUT_OTEL_AUTOSTART=0
DREAMCUT_OTELCOL_EXECUTABLE=
DREAMCUT_OTEL_DIR=
# Optional existing local receiver. When set, server startup does not own a collector.
DREAMCUT_CODEX_OTEL_ENDPOINT=

# Local repository-scoped agent tool activity. Stores redacted command/results locally.
# No raw image bytes, conversation prose or remote export. See docs/observability.md.
DREAMCUT_ACTIVITY_CAPTURE=0

# Optional local visual analyst; export into the MCP/harness process environment.
# DREAMCUT_VISION_BACKENDS='{"default":{"endpoint":"http://127.0.0.1:18341","model":"local-vision-model","revision":"weights-and-projector-v1"}}'
# DREAMCUT_VISION_REVISION=weights-and-projector-v1
