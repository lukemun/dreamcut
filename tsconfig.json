{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-proposals-smoke/types/**/*.ts",
    ".next-proposals-smoke/dev/types/**/*.ts",
    ".next-diag/types/**/*.ts",
    ".next-diag/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next-ntp/types/**/*.ts",
    ".next-ntp/dev/types/**/*.ts",
    ".next-review/types/**/*.ts",
    ".next-review/dev/types/**/*.ts",
    ".next-inspector-check/types/**/*.ts",
    ".next-inspector-check/dev/types/**/*.ts",
    ".next-cutover/types/**/*.ts",
    ".next-cutover/dev/types/**/*.ts",
    ".next-prepared-check/types/**/*.ts",
    ".next-prepared-check/dev/types/**/*.ts",
    ".next-native/types/**/*.ts",
    ".next-native/dev/types/**/*.ts",
    ".next-native-production/types/**/*.ts",
    ".next-native-production/dev/types/**/*.ts",
    ".next-native-batched/types/**/*.ts",
    ".next-native-batched/dev/types/**/*.ts",
    ".next-native-scheduled/types/**/*.ts",
    ".next-native-scheduled/dev/types/**/*.ts",
    ".next-native-proxy-policy/types/**/*.ts",
    ".next-native-proxy-policy/dev/types/**/*.ts",
    ".next-native-settings-webpack/types/**/*.ts",
    ".next-native-settings-webpack/dev/types/**/*.ts",
    ".next-native-buffer/types/**/*.ts",
    ".next-native-buffer/dev/types/**/*.ts",
    ".next-gpu-proof/types/**/*.ts",
    ".next-gpu-proof/dev/types/**/*.ts",
    ".next-zoom-proof/types/**/*.ts",
    ".next-zoom-proof/dev/types/**/*.ts",
    ".next-gpu-root-verify/types/**/*.ts",
    ".next-gpu-root-verify/dev/types/**/*.ts",
    ".next-desktop-dev/types/**/*.ts",
    ".next-desktop-dev/dev/types/**/*.ts",
    ".next-dreamcut/types/**/*.ts",
    ".next-dreamcut/dev/types/**/*.ts",
    ".next-cloudcheck/types/**/*.ts",
    ".next-cloudcheck/dev/types/**/*.ts",
    ".next-demo/types/**/*.ts",
    ".next-demo/dev/types/**/*.ts",
    ".next-chatgen/types/**/*.ts",
    ".next-chatgen/dev/types/**/*.ts",
    ".next-looks/types/**/*.ts",
    ".next-looks/dev/types/**/*.ts",
    ".next-preview-window-qa/types/**/*.ts",
    ".next-preview-window-qa/dev/types/**/*.ts",
    ".next-gen/types/**/*.ts",
    ".next-gen/dev/types/**/*.ts",
    ".next-sentry-verify/types/**/*.ts",
    ".next-sentry-verify/dev/types/**/*.ts",
    ".next-ready/types/**/*.ts",
    ".next-ready/dev/types/**/*.ts",
    ".next-camera/types/**/*.ts",
    ".next-camera/dev/types/**/*.ts",
    ".next-color/types/**/*.ts",
    ".next-color/dev/types/**/*.ts",
    ".next-bugreport/types/**/*.ts",
    ".next-bugreport/dev/types/**/*.ts",
    ".next-voice/types/**/*.ts",
    ".next-voice/dev/types/**/*.ts",
    ".next-perf/types/**/*.ts",
    ".next-perf/dev/types/**/*.ts",
    ".next-blocks/types/**/*.ts",
    ".next-blocks/dev/types/**/*.ts",
    ".next-retro/types/**/*.ts",
    ".next-retro/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "projects",
    "supabase",
    "scripts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
