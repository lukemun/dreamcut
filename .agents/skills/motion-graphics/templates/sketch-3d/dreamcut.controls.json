{
  "schema_version": 1,
  "template": "sketch-3d",
  "object": {
    "label": "3D scene",
    "native_gap": "Native shapes and the camera are flat, so moving a camera through a scene in perspective needs a 3D scene."
  },
  "controls": [
    { "id": "camera", "kind": "choice", "label": "Camera", "default": "fly", "options": [
      { "value": "fly", "label": "Fly through" },
      { "value": "orbit", "label": "Circle round" },
      { "value": "rise", "label": "Rise up" }
    ] },
    { "id": "density", "kind": "number", "label": "Density", "default": 100, "min": 20, "max": 200, "step": 5, "unit": "%" },
    { "id": "height", "kind": "number", "label": "Height", "default": 100, "min": 50, "max": 200, "step": 5, "unit": "%" },
    { "id": "detail", "kind": "number", "label": "Detail", "default": 70, "min": 0, "max": 100, "step": 5, "unit": "%" },
    { "id": "wobble", "kind": "number", "label": "Wobble", "default": 20, "min": 0, "max": 100, "step": 5, "unit": "%" },
    { "id": "variation", "kind": "number", "label": "Variation", "default": 7, "min": 1, "max": 99, "step": 1 },
    { "id": "draw_in", "kind": "number", "label": "Build time", "default": 1.6, "min": 0.5, "max": 4, "step": 0.1, "unit": "s" },
    { "id": "flight", "kind": "number", "label": "Camera time", "default": 4, "min": 1.5, "max": 10, "step": 0.1, "unit": "s" },
    { "id": "hold", "kind": "number", "label": "Hold", "default": 0.4, "min": 0, "max": 3, "step": 0.1, "unit": "s" },
    { "id": "ink", "kind": "color", "label": "Ink", "default": "#1c1b19" },
    { "id": "paper", "kind": "color", "label": "Paper", "default": "#f3efe6" },
    { "id": "backdrop", "kind": "switch", "label": "Paper fill", "default": true }
  ],
  "actors": [{ "id": "scene", "label": "3D scene" }],
  "markers": [],
  "timing": {
    "duration": "draw_in + flight + hold",
    "cues": [
      { "id": "camera_moves", "label": "Camera moves", "at": "draw_in" },
      { "id": "flight_ends", "label": "Flight ends", "at": "draw_in + flight" }
    ]
  },
  "opaque_control": "backdrop"
}
