  "actors": [
    {
      "id": "header",
      "label": "Title"
    },
    {
      "id": "chart",
      "label": "Chart"
    },
    {
      "id": "note",
      "label": "Source note"
    }
  ],
  "markers": [],
  "timing": {
    "cues": [
      {
        "id": "chart_in",
        "label": "Chart starts",
        "at": "chart_start"
      },
      {
        "id": "all_landed",
        "label": "Last item lands",
        "at": "chart_start + grow_time + max(bar_gap * (bar_count - 1), start_1, start_2, start_3, start_4, start_5, start_6)"
      },
      {
        "id": "highlight_in",
        "label": "Highlight",
        "at": "chart_start + grow_time + max(bar_gap * (bar_count - 1), start_1, start_2, start_3, start_4, start_5, start_6) + 0.2"
      }
    ],
    "duration": "chart_start + grow_time + max(bar_gap * (bar_count - 1), start_1, start_2, start_3, start_4, start_5, start_6) + hold"
  },
  "canvas": {
    "control": "shape",
    "sizes": {
      "wide": {
        "width": 1920,
        "height": 1080
      },
      "tall": {
        "width": 1080,
        "height": 1920
      },
      "square": {
        "width": 1080,
        "height": 1080
      }
    }
  },
  "opaque_control": "backdrop"
