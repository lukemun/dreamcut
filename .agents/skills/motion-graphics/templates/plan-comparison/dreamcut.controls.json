      "default": 0.5,
      "min": 0,
      "max": 5,
      "step": 0.05,
      "unit": "s"
    },
    {
      "id": "card_gap",
      "kind": "number",
      "label": "Card gap",
      "default": 0.22,
      "min": 0,
      "max": 1.5,
      "step": 0.02,
      "unit": "s"
    },
    {
      "id": "tick_gap",
      "kind": "number",
      "label": "Tick gap",
      "default": 0.22,
      "min": 0.05,
      "max": 1,
      "step": 0.01,
      "unit": "s"
    },
    {
      "id": "hold",
      "kind": "number",
      "label": "Hold",
      "default": 3,
      "min": 0.5,
      "max": 15,
      "step": 0.1,
      "unit": "s"
    },
    {
      "id": "entrance",
      "kind": "number",
      "label": "Entrance",
      "default": 0.7,
      "min": 0.2,
      "max": 1.5,
      "step": 0.05,
      "unit": "s"
    },
    {
      "id": "own_accent",
      "kind": "switch",
      "label": "Own accent",
      "default": false
    },
    {
      "id": "accent",
      "kind": "color",
      "label": "Accent",
      "default": "#e4572e"
    },
    {
      "id": "backdrop",
      "kind": "switch",
      "label": "Backdrop",
      "default": true
    }
  ],
  "actors": [
    {
      "id": "heading",
      "label": "Heading"
    },
    {
      "id": "plans",
      "label": "Plans"
    }
  ],
  "markers": [],
  "timing": {
    "cues": [
      {
        "id": "cards_in",
        "label": "Cards arrive",
        "at": "cards_start"
      },
      {
        "id": "ticks_in",
        "label": "Ticks start",
        "at": "cards_start + card_gap * (plan_count - 1) + entrance * 0.8"
      },
      {
        "id": "highlight_in",
        "label": "Highlight",
        "at": "cards_start + card_gap * (plan_count - 1) + entrance * 0.8 + 4 * tick_gap + 0.55"
      }
    ],
    "duration": "cards_start + card_gap * (plan_count - 1) + entrance * 0.8 + 4 * tick_gap + 0.55 + hold"
  },
  "canvas": {
    "control": "shape",
    "sizes": {
      "wide": {
        "width": 1920,
        "height": 1080
      },
      "tall": {
        "width": 1080,
        "height": 1920
      },
      "square": {
        "width": 1080,
        "height": 1080
      }
    }
  },
  "opaque_control": "backdrop"
}
