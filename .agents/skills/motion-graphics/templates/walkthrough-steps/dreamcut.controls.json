        },
        {
          "value": "tall",
          "label": "9:16"
        },
        {
          "value": "square",
          "label": "1:1"
        }
      ],
      "fixed": true
    },
    {
      "id": "heading",
      "kind": "text",
      "label": "Heading",
      "default": "Set up in four steps",
      "max_length": 48
    },
    {
      "id": "step_count",
      "kind": "number",
      "label": "Steps",
      "default": 4,
      "min": 2,
      "max": 4,
      "step": 1,
      "unit": "steps"
    },
    {
      "id": "step_1_title",
      "kind": "text",
      "label": "Step 1",
      "default": "Create a project",
      "max_length": 48
    },
    {
      "id": "step_1_detail",
      "kind": "text",
      "label": "Step 1 detail",
      "default": "Name it and pick where it lives.",
      "max_length": 110
    },
    {
      "id": "image_1",
      "kind": "text",
      "label": "Step 1 picture",
      "default": "",
      "max_length": 120,
      "fixed": true
    },
    {
      "id": "step_2_title",
      "kind": "text",
      "label": "Step 2",
      "default": "Bring in your files",
      "max_length": 48
    },
    {
      "id": "step_2_detail",
      "kind": "text",
      "label": "Step 2 detail",
      "default": "Drop a folder; it copies in the background.",
      "max_length": 110
    },
    {
      "id": "image_2",
      "kind": "text",
      "label": "Step 2 picture",
      "default": "",
      "max_length": 120,
      "fixed": true
    },
    {
      "id": "step_3_title",
      "kind": "text",
      "label": "Step 3",
      "default": "Invite your team",
      "max_length": 48
    },
    {
      "id": "step_3_detail",
      "kind": "text",
      "label": "Step 3 detail",
      "default": "Everyone sees changes as they happen.",
      "max_length": 110
    },
    {
      "id": "image_3",
      "kind": "text",
      "label": "Step 3 picture",
      "default": "",
      "max_length": 120,
      "fixed": true
    },
    {
      "id": "step_4_title",
      "kind": "text",
      "label": "Step 4",
      "default": "Share a review link",
      "max_length": 48
    },
    {
      "id": "step_4_detail",
      "kind": "text",
      "label": "Step 4 detail",
      "default": "Comments land right on the frame.",
      "max_length": 110
    },
    {
      "id": "image_4",
      "kind": "text",
      "label": "Step 4 picture",
      "default": "",
      "max_length": 120,
      "fixed": true
    },
    {
      "id": "intro",
      "kind": "number",
      "label": "Intro",
      "default": 0.8,
      "min": 0.2,
      "max": 4,
      "step": 0.05,
      "unit": "s"
    },
    {
      "id": "step_hold",
      "kind": "number",
      "label": "Step time",
      "default": 2.8,
      "min": 1,
      "max": 10,
      "step": 0.1,
      "unit": "s"
    },
    {
      "id": "change",
      "kind": "number",
      "label": "Step change",
      "default": 0.4,
      "min": 0.1,
      "max": 1.2,
      "step": 0.05,
      "unit": "s"
    },
    {
      "id": "hold",
      "kind": "number",
      "label": "End hold",
      "default": 0.8,
      "min": 0,
      "max": 6,
      "step": 0.1,
      "unit": "s"
    },
    {
      "id": "entrance",
      "kind": "number",
      "label": "Entrance",
      "default": 0.7,
      "min": 0.2,
      "max": 1.5,
      "step": 0.05,
      "unit": "s"
    },
    {
      "id": "own_accent",
      "kind": "switch",
      "label": "Own accent",
      "default": false
    },
    {
      "id": "accent",
      "kind": "color",
      "label": "Accent",
      "default": "#e4572e"
    },
    {
      "id": "backdrop",
      "kind": "switch",
      "label": "Backdrop",
      "default": true
    }
  ],
  "actors": [
    {
      "id": "heading",
      "label": "Heading"
    },
    {
      "id": "screen",
      "label": "Screen"
    },
    {
      "id": "steps",
      "label": "Step text"
    },
    {
      "id": "progress",
      "label": "Progress"
    }
  ],
  "markers": [],
  "timing": {
    "cues": [
      {
        "id": "step_1_in",
        "label": "Step 1",
        "at": "intro"
      },
      {
        "id": "step_2_in",
        "label": "Step 2",
        "at": "intro + 1 * step_hold"
      },
      {
        "id": "step_3_in",
        "label": "Step 3",
        "at": "intro + 2 * step_hold"
      },
      {
        "id": "step_4_in",
        "label": "Step 4",
        "at": "intro + 3 * step_hold"
      }
    ],
    "duration": "intro + step_count * step_hold + hold"
  },
  "canvas": {
    "control": "shape",
    "sizes": {
      "wide": {
        "width": 1920,
        "height": 1080
      },
      "tall": {
        "width": 1080,
        "height": 1920
      },
      "square": {
        "width": 1080,
        "height": 1080
      }
    }
  },
  "opaque_control": "backdrop"
}
