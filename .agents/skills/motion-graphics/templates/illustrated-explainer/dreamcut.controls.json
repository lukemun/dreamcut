  "timing": {
    "cues": [
      {
        "id": "chart_in",
        "label": "Chart",
        "at": "title_hold"
      },
      {
        "id": "object_in",
        "label": "Object",
        "at": "title_hold + chart_hold"
      },
      {
        "id": "people_in",
        "label": "People",
        "at": "title_hold + chart_hold + object_hold"
      },
      {
        "id": "process_in",
        "label": "Process",
        "at": "title_hold + chart_hold + object_hold + people_hold"
      },
      {
        "id": "compare_in",
        "label": "Comparison",
        "at": "title_hold + chart_hold + object_hold + people_hold + process_hold"
      },
      {
        "id": "closing_in",
        "label": "Closing line",
        "at": "title_hold + chart_hold + object_hold + people_hold + process_hold + compare_hold"
      }
    ],
    "duration": "title_hold + chart_hold + object_hold + people_hold + process_hold + compare_hold + closing_hold"
  },
